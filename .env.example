# Realtime provider: "huggingface" (default) or "openai".
# BACKEND_PROVIDER="huggingface"

# Direct OpenAI Realtime credentials and model.
# The API key can also be saved or replaced from the Settings UI.
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL="gpt-realtime-2.1"
# Optional realtime input transcription language.
# Defaults to "auto" for automatic language detection. Set to "en" for English or "zh" for Chinese to fix the language.
# REALTIME_TRANSCRIPTION_LANGUAGE="auto"

# Local Silero VAD supplements server VAD for antenna freeze and idle movement. Hugging Face provider only.
# Defaults to true; saved Settings → Speech behavior choices override this value.
# LOCAL_VAD_ENABLED=true

# Local barge-in: duck playback on possible speech until server VAD confirms the turn. Requires local VAD.
# Hugging Face provider only.
# Defaults to true; editable from Settings → Speech behavior.
# LOCAL_BARGE_IN_ENABLED=true

# Hugging Face connection mode: "deployed" or "local".
# Deployed mode uses the built-in Hugging Face server.
# Defaults to "deployed" when unset.
# HF_REALTIME_CONNECTION_MODE="deployed"

# Direct Hugging Face realtime endpoint for local/LAN backends.
# Accepts either the base URL (`ws://127.0.0.1:8765/v1`) or the full realtime URL
# (`ws://127.0.0.1:8765/v1/realtime`). Used when HF_REALTIME_CONNECTION_MODE=local.
# HF_REALTIME_WS_URL="ws://127.0.0.1:8765/v1/realtime"

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Optional built-in profile selector. Use a folder name from profiles/.
# If unset, the app uses the default profile unless startup settings were saved from the UI.
# REACHY_MINI_CUSTOM_PROFILE=mars_rover

# Optional external profile/tool directories
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Optional: discover and auto-load all tools found in REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY,
# even if they are not enabled by the selected profile or its Tool access override.
# This is convenient for downloaded tools used with built-in/default profiles.
# AUTOLOAD_EXTERNAL_TOOLS=1

# Minutes of inactivity before Reachy goes to sleep and the app stops. Default 1440 (one day), 0 disables.
# REACHY_MINI_APP_TIMEOUT_MINUTES=1440

# Local wake gating is enabled by default with the bundled "Hey Emma" ONNX model.
# REACHY_MINI_WAKE_WORD_ENABLED=true
# Optional path to another openWakeWord ONNX model.
# REACHY_MINI_WAKE_WORD_MODEL=/path/to/custom_wake_word.onnx
# Detection confidence from greater than 0 through 1. Default 0.5.
# REACHY_MINI_WAKE_WORD_THRESHOLD=0.5
# Final user transcripts containing one of these comma-separated phrases put Reachy to sleep.
# REACHY_MINI_SLEEP_PHRASES="goodbye emma,go to sleep,go sleep,sleep now,time to sleep,good night"

# Obsidian Sync through Obsidian Headless (`ob`). Off by default. Configure it from the Settings UI.
# The app does not install Node.js or `ob`; install `obsidian-headless` on the device first.
# Sign in from the Settings UI. The account password is not stored here.
# OBSIDIAN_SYNC_ENABLED=false
# OBSIDIAN_HEADLESS_BIN=ob
# Remote vault name or ID, as listed by `ob sync-list-remote`.
# OBSIDIAN_SYNC_VAULT=
# Local vault folder. Defaults to <instance path>/obsidian/<vault>.
# OBSIDIAN_SYNC_PATH=
# OBSIDIAN_SYNC_DEVICE_NAME=reachy-mini
# "bidirectional" (default) or "pull-only". "mirror-remote" is refused because it reverts local writes.
# OBSIDIAN_SYNC_MODE=bidirectional
# "merge" (default) or "conflict".
# OBSIDIAN_SYNC_CONFLICT_STRATEGY=merge
# End-to-end encryption password of the remote vault. Secret: the Settings UI never shows it.
# OBSIDIAN_SYNC_E2EE_PASSWORD=

# Settings PIN, stored as a scrypt hash. The Settings UI sets it the first time you change a protected setting.
# Remove this line and restart the app to reset the PIN.
# REACHY_MINI_SETTINGS_PIN_HASH=

# Directory holding this instance's data: long-term memory, user personalities and settings.
# Applies when the app starts as a Reachy Mini app (from the daemon or dashboard): defaults to a
# conversation_app folder beside the daemon's own config (~/.config/reachy_mini), and legacy data
# from the installed package is copied there once. The standalone `reachy-mini-conversation-app --ui`
# run uses $XDG_DATA_HOME/reachy_mini_conversation_app (default ~/.local/share/reachy_mini_conversation_app)
# and ignores this setting; without --ui there is no instance directory.
# Set it in the process environment: the instance .env lives inside that
# directory, so a value written there is read too late to take effect.
# REACHY_MINI_INSTANCE_PATH=~/reachy-mini-data

# Long-term memory: remembered facts are injected into the prompt and the
# remember/forget tools work. Turning it off keeps the stored facts. Default true.
# REACHY_MINI_MEMORY_ENABLED=true

# Camera tool. --no-camera still forces it off whatever this says. Default true.
# REACHY_MINI_CAMERA_ENABLED=true
